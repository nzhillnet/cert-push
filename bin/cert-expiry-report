#!/usr/bin/env python3
"""Daily certificate-expiry check; e-mails MAIL_TO when anything is close to expiry.

Checks:
  1. every host in hosts.conf.yaml: the certificate actually DEPLOYED on the host (read over
     SSH with the cert-deploy key) -- catches a renewal that never reached the host;
  2. EXTRA endpoints below (certs not managed by this tool, e.g. issued by certbot elsewhere,
     or imported by hand into an appliance): what the service actually SERVES over TLS.

Usage:
  cert-expiry-report            e-mail only if something expires within DAYS or a check fails
  cert-expiry-report --all      always e-mail the full table (e.g. to test)
  cert-expiry-report --print    print the table, no e-mail

Written after a cert nearly expired unnoticed because the renewal tool's own API token had
silently gone dead -- checking what's actually deployed/served catches that a config-only
check (acme.sh's own renewal log) would miss.
"""
import datetime, os, socket, ssl, subprocess, sys

HOST = socket.gethostname().split(".")[0]   # where this runs, for the mail text
import yaml

DAYS = int(os.environ.get("CERT_EXPIRY_DAYS", "14"))
MAIL_TO = os.environ.get("CERT_EXPIRY_MAIL_TO", "you@example.com")
HOSTS_YAML = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hosts.conf.yaml")
DEPLOY_KEY = os.path.expanduser("~/.ssh/cert-deploy")

# Certificates not managed by this tool: (label, connect-to host, port, SNI name).
# Edit this list for your own externally-issued or hand-imported certs, or leave it empty.
EXTRA = [
    # ("example.com (certbot on some-host)", "203.0.113.10", 443, "example.com"),
]

def not_after(pem_or_der, der=False):
    args = ["openssl", "x509", "-noout", "-enddate"] + (["-inform", "DER"] if der else [])
    out = subprocess.run(args, input=pem_or_der, capture_output=True, check=True).stdout.decode()
    return datetime.datetime.strptime(out.strip().split("=", 1)[1], "%b %d %H:%M:%S %Y %Z").replace(tzinfo=datetime.timezone.utc)

def deployed_cert(h, domain):
    path = h.get("remote_cert_path", f"/etc/ssl/{h['name']}/").rstrip("/") + "/cert.pem"
    if h["deploy_target"] in ("localhost", "127.0.0.1"):     # renewed copy kept on this host
        return not_after(open(path, "rb").read())
    user = h.get("deploy_user", "root")
    cmd = f"sudo cat {path}" if h.get("transfer_sudo") else f"cat {path}"
    r = subprocess.run(["ssh", "-n", "-i", DEPLOY_KEY, "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
                        f"{user}@{h['deploy_target']}", cmd], capture_output=True, timeout=30)
    if r.returncode or b"BEGIN CERTIFICATE" not in r.stdout:
        raise RuntimeError(f"could not read {path} on {h['deploy_target']}")
    return not_after(r.stdout)

def served_cert(host, port, sni):
    ctx = ssl.create_default_context()
    ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE
    with socket.create_connection((host, port), timeout=8) as s, ctx.wrap_socket(s, server_hostname=sni) as t:
        return not_after(t.getpeercert(binary_form=True), der=True)

def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    conf = yaml.safe_load(open(HOSTS_YAML))
    now = datetime.datetime.now(datetime.timezone.utc)
    rows, problems = [], []
    checks = [(f"{h['name']}.{conf['domain']} (" + (f"renewed copy on {HOST}" if h["deploy_target"] in ("localhost", "127.0.0.1") else "deployed copy") + ")", lambda h=h: deployed_cert(h, conf["domain"]))
              for h in conf["hosts"]]
    checks += [(label, lambda a=(host, port, sni): served_cert(*a)) for label, host, port, sni in EXTRA]
    for label, fn in checks:
        try:
            exp = fn()
            days = (exp - now).days
            rows.append((days, label, exp.strftime("%Y-%m-%d")))
            if days <= DAYS:
                problems.append(f"EXPIRES in {days} days ({exp:%Y-%m-%d}): {label}")
        except Exception as e:
            rows.append((-9999, label, "CHECK FAILED"))
            problems.append(f"CHECK FAILED: {label} -- {e}")
    rows.sort()
    table = "\n".join(f"{('%4d' % d) if d != -9999 else '   ?'} days  {when:<12}  {label}" for d, label, when in rows)
    body = ("Problems:\n  " + "\n  ".join(problems) + "\n\n" if problems else "Nothing expires within %d days.\n\n" % DAYS) \
           + "All certificates (days left, expiry date, what):\n" + table + \
           "\n\nGenerated by bin/cert-expiry-report on " + HOST + ".\n"
    if mode == "--print":
        print(body); return
    if problems or mode == "--all":
        subject = (f"[{HOST}] Cert expiry: {len(problems)} need attention" if problems
                   else f"[{HOST}] Cert expiry report: all {len(rows)} OK")
        msg = f"To: {MAIL_TO}\nSubject: {subject}\n\n{body}"
        subprocess.run(["/usr/sbin/sendmail", "-t"], input=msg.encode(), check=True)

if __name__ == "__main__":
    main()
